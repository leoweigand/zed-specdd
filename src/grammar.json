                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "_end_of_line"
          }
        ]
      }
    },
    "task_marker": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "[ ]"
        },
        {
          "type": "STRING",
          "value": "[x]"
        },
        {
          "type": "STRING",
          "value": "[X]"
        },
        {
          "type": "STRING",
          "value": "[-]"
        },
        {
          "type": "STRING",
          "value": "[!]"
        },
        {
          "type": "STRING",
          "value": "[?]"
        }
      ]
    },
    "task_id": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "#[0-9]+"
        }
      }
    },
    "_content": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_inline"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_space"
              },
              {
                "type": "SYMBOL",
                "name": "_inline"
              }
            ]
          }
        }
      ]
    },
    "_inline": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "inline_code"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "SYMBOL",
          "name": "symbol_reference"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_opening_punctuation"
        }
      ]
    },
    "inline_code": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "`[^`\\r\\n]*`"
        }
      }
    },
    "path": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "(?:\\.\\/|\\.\\.\\/|\\/)(?:[A-Za-z0-9_*?.,{}\\[\\]\\/\\-]*[A-Za-z0-9_*?{}\\[\\]\\/\\-])?"
        }
      }
    },
    "symbol_reference": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "@[_A-Za-z](?:[_A-Za-z0-9.:#\\\\/?!]*[_A-Za-z0-9#\\\\/?!])?"
        }
      }
    },
    "text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^ \\t\\r\\n`(\\[{<\"']+"
        },
        {
          "type": "STRING",
          "value": "`"
        }
      ]
    },
    "_opening_punctuation": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PATTERN",
            "value": "[ \\t]*#[^\\r\\n]*"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_end_of_line"
        }
      ]
    },
    "_blank_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[ \\t]*(?:\\r\\n|\\n|\\r)"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_space"
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "_space": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r\\n|\\n|\\r"
    },
    "_end_of_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_newline"
        },
        {
          "type": "SYMBOL",
          "name": "_eof"
        }
      ]
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_eof"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
