      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "step_keyword"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_space"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_content"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "step_keyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "Given"
        },
        {
          "type": "STRING",
          "value": "When"
        },
        {
          "type": "STRING",
          "value": "Then"
        },
        {
          "type": "STRING",
          "value": "And"
        },
        {
          "type": "STRING",
          "value": "But"
        }
      ]
    },
    "task": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "  "
          },
          {
            "type": "FIELD",
            "name": "state",
            "content": {
              "type": "SYMBOL",
