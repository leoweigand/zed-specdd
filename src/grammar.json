        {
          "type": "STRING",
          "value": "Depends on"
        },
        {
          "type": "STRING",
          "value": "Exposes"
        },
        {
          "type": "STRING",
          "value": "Accepts"
        },
        {
          "type": "STRING",
          "value": "Returns"
        },
        {
          "type": "STRING",
          "value": "Raises"
        },
        {
          "type": "STRING",
          "value": "Handles"
